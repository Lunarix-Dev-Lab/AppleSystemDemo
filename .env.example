# ── Aplicación ──────────────────────────────────────────────────────────────
# Clave secreta para firmar JWT. Generá una con: openssl rand -hex 32
SECRET_KEY=cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres
DEBUG=false
# Orígenes permitidos para CORS (JSON array)
ALLOWED_ORIGINS=["http://localhost:4000"]

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_DB=sistemaapple
POSTGRES_USER=apple
POSTGRES_PASSWORD=apple123
# Para desarrollo local (fuera de Docker):
DATABASE_URL=postgresql+asyncpg://apple:apple123@localhost:5432/sistemaapple

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL pública del frontend (usada en los links de los emails)
FRONTEND_URL=http://localhost:4000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password-de-gmail
SMTP_FROM=tu-email@gmail.com
SMTP_TLS=true

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
# Dejá vacío para usar el stub (solo loguea, no envía mensajes reales).
# Un despliegue recién clonado funciona sin configurar WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0
# Número del dueño que recibe el aviso de nuevo turno por WhatsApp (ej: 5491112345678)
BUSINESS_PHONE=
